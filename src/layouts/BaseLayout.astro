---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f6fa" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- D26 logo. ?v=2 makes browsers drop the cached old icon; .ico and PNG cover Safari, iOS and search results -->
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <slot name="head" />
    <!-- Vercel Web Analytics (D11): cookieless page views as a cross-check for PostHog -->
    <Analytics />
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <slot />
    <script>
      // Funnel measurement – PostHog EU, cookieless (D11, D24)
      import '../lib/analytics';
    </script>
  </body>
</html>
