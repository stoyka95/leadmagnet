---
// D36: the page's own line icons – one place for all of them, no icon library, no extra download (inline SVG).
// 24 × 24 grid, 1.75 stroke, round ends. The outline takes the text colour (navy by default),
// one detail is green like the arrow in the logo. Decorative by default (aria-hidden); pass `label` when the icon alone carries meaning.
export type IconName =
  | 'compare' | 'coins' | 'chart' | 'question' | 'mail-pdf'
  | 'lock' | 'document' | 'receipt' | 'shield-check' | 'bank' | 'search';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

// [outline, green accent]
const PATHS: Record<IconName, [string, string]> = {
  // two funds side by side – the European one in green
  compare: ['M3.5 4.5h7v15h-7z M13.5 4.5h7v15h-7z M6 9h2 M6 12.5h2 M6 16h2', 'M16 9h2 M16 12.5h2 M16 16h2'],
  // a stack of coins and one more – fees in crowns
  coins: ['M3.5 6.5c0-1.4 2.2-2.5 5-2.5s5 1.1 5 2.5-2.2 2.5-5 2.5-5-1.1-5-2.5z M3.5 6.5v11c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5v-11 M3.5 10.2c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5 M3.5 13.9c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5', 'M17.75 12a3.25 3.25 0 1 1 0 6.5 3.25 3.25 0 0 1 0-6.5z'],
  // axes and a rising line – scenarios and history
  chart: ['M4 4v16h16', 'M7.5 15l3.5-4 3 2.5 5-6.5'],
  // a speech bubble with a question mark – what to ask the broker
  question: ['M4 4.5h16v11.5H10l-4.5 3.5V16H4z', 'M9.75 8.75a2.25 2.25 0 1 1 3.1 2.1c-.5.2-.85.6-.85 1.15v.3 M12 14.2v.05'],
  // an envelope and the logo's arrow – sent by e-mail, with the PDF
  'mail-pdf': ['M3 9h13v10.5H3z M3 10l6.5 4.5L16 10', 'M15.5 3H21v5.5 M21 3l-4.5 4.5'],
  // a padlock – no spam, data kept safe
  lock: ['M6.5 11V8a5.5 5.5 0 0 1 11 0v3 M5 11h14v10H5z', 'M12 14.5v3'],
  // a document with a folded corner – the KID
  document: ['M6 3h8.5L18 6.5V21H6z M14.5 3v3.5H18', 'M9 12h6 M9 15.5h6'],
  // a receipt with a percent sign – tax
  receipt: ['M6 3h12v18l-2.5-1.75L13 21l-2.5-1.75L8 21l-2-1.4z', 'M9.5 14l5-6 M9.75 8.5v.05 M14.25 13.5v.05'],
  // a shield with a tick – data from the issuers
  'shield-check': ['M12 3l7.5 3v5.5c0 4.4-3.1 8-7.5 9.5-4.4-1.5-7.5-5.1-7.5-9.5V6z', 'M8.75 12l2.25 2.25 4.25-4.5'],
  // a bank building – the broker
  bank: ['M3.5 9L12 4.5 20.5 9 M5.5 9.5v7.5 M9.8 9.5v7.5 M14.2 9.5v7.5 M18.5 9.5v7.5', 'M3.5 20h17'],
  // a magnifying glass – look the fund up by ISIN
  search: ['M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13z', 'M15.5 15.5L20 20'],
};

const { name, size = 24, label, class: className } = Astro.props;
const [outline, accent] = PATHS[name];
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={outline} stroke="currentColor" />
  <path d={accent} class="icon-accent" />
</svg>

<style>
  .icon { flex: none; display: inline-block; vertical-align: middle; }
  .icon-accent { stroke: var(--c-green-700); }
</style>
