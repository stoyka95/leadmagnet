---
// CONTENT.md §3.4 – every claim is backed by a source in data/SOURCES.md §4. D31: two points; "same index" lives in the FAQ.
const points = [
  {
    title: 'Chybí „KID“.',
    text: 'Evropská pravidla (PRIIPs) vyžadují pro drobné investory dokument klíčových informací. Američtí správci ho obvykle nevydávají.',
    sources: [
      { label: 'IBKR', href: 'https://www.interactivebrokers.com/lib/cstools/faq/content/1136192471' },
      { label: 'ČNB', href: 'https://www.cnb.cz/cs/dohled-financni-trh/legislativni-zakladna/stanoviska-k-regulaci-financniho-trhu/RS2018-12' },
    ],
  },
  {
    title: 'Záleží na brokerovi.',
    text: 'Někteří brokeři americká ETF drobným investorům z EU blokují (např. Interactive Brokers), jiní je zpřístupňují (např. Fio).',
    sources: [
      { label: 'IBKR', href: 'https://www.interactivebrokers.com/lib/cstools/faq/content/1136192471' },
      { label: 'Fio', href: 'https://www.fio.cz/akcie-investice/etf' },
    ],
  },
];
---
<section id="proc-voo" class="block" aria-labelledby="kid-h">
  <h3 id="kid-h" class="block-h">Proč VOO u svého brokera možná nenajdete</h3>
  <ol class="points">
    {points.map((p, i) => (
      <li>
        <span class="n num" aria-hidden="true">{i + 1}</span>
        <div>
          <h4>{p.title}</h4>
          <p class="muted">{p.text}</p>
          <p class="fine">Zdroj: {p.sources.map((s, j) => <>{j > 0 && <span class="sep" aria-hidden="true">·</span>}<a href={s.href} rel={s.href.startsWith('http') ? 'noopener' : undefined}>{s.label}</a></>)}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .block-h { font-size: var(--fs-xl); margin-bottom: var(--sp-5); }
  .points { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-5); }
  li { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-4); }
  .n { width: 36px; height: 36px; border-radius: var(--r-pill); background: var(--c-navy-700); color: var(--c-white); display: grid; place-items: center; font-weight: var(--fw-bold); }
  h4 { margin: 0 0 var(--sp-1); font-size: var(--fs-md); color: var(--c-navy-900); }
  .fine { margin-top: var(--sp-2); }
  .sep { margin-inline: var(--sp-3); } /* D35: neighbouring source links do not share one touch area */
</style>
