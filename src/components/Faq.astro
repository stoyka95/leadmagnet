---
// CONTENT.md §3.7 + the last (catch-all) form.
import LeadForm from './LeadForm.astro';
import WhoWeAre from './WhoWeAre.astro';
import { etfByTicker, formatPct } from '../lib/etf';
const spy = etfByTicker('SPY');
const voo = etfByTicker('VOO');
type Faq = { q: string; a: string; source?: { label: string; href: string } };
const faqs: Faq[] = [
  { q: 'Je mezi SPY, IVV a VOO rozdíl?', a: `Sledují stejný index S&P 500, liší se hlavně správcem a poplatkem (${formatPct(spy.expenseRatioPct)} vs. ${formatPct(voo.expenseRatioPct)}).` },
  { q: 'Co je UCITS a sleduje evropská verze stejný index?', a: 'UCITS jsou evropská pravidla pro fondy. UCITS ETF mají dokument KID, proto je drobní investoři v EU běžně koupí. U S&P 500 sledují evropské verze stejný index, u VTI, VT a SCHD jde o nejbližší alternativu s jiným indexem – ve srovnání je to vždy uvedené.', source: { label: 'weby správců', href: '/zdroje' } },
  { q: 'Jak se daní dividendy z amerických ETF?', a: 'V USA se srazí nejvýše 15 %, pokud má broker váš formulář W-8BEN. V Česku se dividendy uvádějí v daňovém přiznání a americkou daň lze započíst. Obecná informace, ne daňové poradenství.', source: { label: 'smlouva ČR–USA čl. 10, IRS, Finanční správa', href: '/zdroje#dane' } },
  { q: 'Proč kalkulačka nepočítá poplatky brokera a směnu měny?', a: 'Liší se podle brokera a často se mění. Počítáme jen roční poplatek fondu (TER) podle správce. Poplatky za nákup a převod měny si ověřte u svého brokera – otázky pro něj najdete ve srovnání, které vám pošleme.' },
  { q: 'Je to investiční doporučení?', a: 'Ne. Srovnáváme veřejné údaje správců. Rozhodnutí je na vás.' },
  { q: 'Co s mými údaji?', a: 'Použijeme je k zaslání srovnání. Další e-maily nebo telefonát jen pokud zaškrtnete souhlas. Souhlas můžete kdykoli odvolat e-mailem na mykola@stoyka.eu.' },
];
---
<section id="zaver" class="section container" aria-labelledby="faq-h">
  <div class="grid">
    <div>
      <div class="section-head">
        <p class="eyebrow">Časté otázky</p>
        <h2 id="faq-h">Než si srovnání necháte poslat</h2>
      </div>
      <div class="faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="muted">{f.a}{f.source && <> Zdroj: <a href={f.source.href}>{f.source.label}</a>.</>}</p>
          </details>
        ))}
      </div>
      <WhoWeAre />
    </div>
    <LeadForm location="footer" />
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--sp-10); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; align-items: start; } }
  .faq { display: grid; }
  details { border-top: 1px solid var(--c-line); }
  details:last-child { border-bottom: 1px solid var(--c-line); }
  summary { cursor: pointer; min-height: var(--tap); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); font-weight: var(--fw-medium); list-style: none; padding-block: var(--sp-3); }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: var(--fs-xl); color: var(--c-green-700); line-height: 1; }
  details[open] summary::after { content: '–'; }
  details p { padding-bottom: var(--sp-4); }
</style>
