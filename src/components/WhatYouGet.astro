---
// CONTENT.md §3.5 – repeats the value for visitors who skipped the form under the calculator.
import GlassCard from './GlassCard.astro';
import Icon, { type IconName } from './Icon.astro';
import { etfByTicker, ucitsFor, formatPct } from '../lib/etf';
import { DEFAULT_CALC } from '../lib/calc-state';

const nf = new Intl.NumberFormat('cs-CZ');
const preview = ['VOO', 'SPY'].flatMap((t) => {
  const us = etfByTicker(t);
  const eu = ucitsFor(us);
  return [
    { label: us.ticker, ter: us.expenseRatioPct },
    { label: `→ ${eu.ticker.split(' ')[0]} (UCITS)`, ter: eu.terPct },
  ];
});
// D36: an icon per item instead of a generic tick
const items: { icon: IconName; text: string }[] = [
  { icon: 'compare', text: 'Všech 6 fondů a jejich evropské verze a alternativy vedle sebe' },
  { icon: 'coins', text: 'Poplatky v korunách pro vaši částku na 10 a 20 let' },
  { icon: 'chart', text: '4 scénáře vývoje investice z dokumentu KID a historie S&P 500' },
  { icon: 'question', text: 'Na co se zeptat brokera a odkazy na oficiální zdroje' },
  { icon: 'mail-pdf', text: 'V e-mailu i jako PDF v příloze' },
];
---
<section id="co-posleme" class="section container" aria-labelledby="get-h">
  <div class="grid">
    <div class="section-head">
      <p class="eyebrow">Zdarma do e-mailu</p>
      <h2 id="get-h">Co vám pošleme</h2>
      <ul class="list">
        {items.map((it) => <li><Icon name={it.icon} /><span>{it.text}</span></li>)}
      </ul>
      <a class="btn btn-primary" href="#lf-footer-h" data-track="cta_click" data-cta="what_you_get" data-to-email="lf-footer-email">Chci srovnání</a>
    </div>

    <GlassCard class="preview" aria-label="Náhled e-mailu se srovnáním">
      <p class="fine">Od: Fingramo · Předmět: Vaše srovnání ETF</p>
      <p class="hello">Dobrý den, tady je vaše srovnání pro {nf.format(DEFAULT_CALC.onceCzk)} Kč + {nf.format(DEFAULT_CALC.monthlyCzk)} Kč měsíčně na {DEFAULT_CALC.years} let.</p>
      {preview.map((r) => <div class="mock-row"><span>{r.label}</span><span class="num">{formatPct(r.ter)}</span></div>)}
      <p class="fine more">… a další 4 fondy, poplatky v Kč, scénáře a zdroje · PDF v příloze</p>
    </GlassCard>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--sp-8); align-items: center; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  .section-head { margin-bottom: 0; }
  .list { list-style: none; padding: 0; margin: var(--sp-2) 0 var(--sp-4); display: grid; gap: var(--sp-3); }
  .list li { display: grid; grid-template-columns: 24px 1fr; gap: var(--sp-3); align-items: start; color: var(--c-navy-700); }
  .list li span { color: var(--c-ink); }
  .btn { justify-self: start; }
  .hello { margin: var(--sp-3) 0 var(--sp-4); font-weight: var(--fw-medium); }
  .mock-row { display: flex; justify-content: space-between; padding-block: var(--sp-2); border-top: 1px solid var(--c-line); font-size: var(--fs-sm); }
  .more { margin-top: var(--sp-3); }
</style>

<script>
  // QA 12. 10.: into the e-mail field of the last form (the link alone ended at the FAQ, the form ~1 100 px lower)
  document.querySelector<HTMLAnchorElement>('[data-to-email]')?.addEventListener('click', (e) => {
    const field = document.getElementById((e.currentTarget as HTMLElement).dataset.toEmail!) as HTMLInputElement | null;
    if (!field) return;
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    field.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    field.focus({ preventScroll: true });
  });
</script>
