---
// First screen. Headline follows the ad the visitor came from (D17): utm_content=a -> "VOO" angle, otherwise B.
// The variant is set on <html data-ad> by an inline script in <head> before first paint (no flicker).
import GlassCard from './GlassCard.astro';
import { etfByTicker, formatPct, formatDate, dataRetrieved, usEtfs, ucitsFor } from '../lib/etf';

const spy = etfByTicker('SPY');
const voo = etfByTicker('VOO');
// Computed from data, not typed in: 0.0945 / 0.03 ≈ 3
const feeRatio = Math.round(spy.expenseRatioPct / voo.expenseRatioPct);
// D29: card for ad A ("your broker may not offer it") – the same three pairs as the ad, from data
const pairs = ['VOO', 'SPY', 'VT'].map((t) => {
  const us = etfByTicker(t);
  const eu = ucitsFor(us);
  return { us, eu, euTicker: eu.ticker.split(' ')[0] };
});
---
<header class="hero container">

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Srovnání ETF z newyorské burzy · zdarma</p>

      <h1 class="variant-a">Chcete VOO nebo SPY? Ukážeme vám, co si z&nbsp;Česka opravdu koupíte.</h1>
      <h1 class="variant-b">Stejný index, jiný poplatek. Kolik vás ETF stojí v&nbsp;korunách?</h1>

      <p class="lead variant-a">Srovnání 6 nejpopulárnějších ETF z newyorské burzy a jejich evropských verzí. Poplatky v&nbsp;korunách pro vaši částku – zdarma.</p>
      <p class="lead variant-b">Zadejte částku a za 10 vteřin uvidíte, kolik zaplatíte na poplatcích ETF z NYSE. Celé srovnání 6 fondů a jejich evropských verzí vám pošleme zdarma.</p>

      <div class="cta-row">
        <a class="btn btn-primary hero-cta" href="#kalkulacka" data-track="cta_click" data-cta="hero">Spočítat moje poplatky</a>
      </div>
      <!-- D28 live test, variant hero_input: the calculator starts right here -->
      <form class="hero-calc" data-hero-calc novalidate>
        <label for="h-monthly">Kolik chcete investovat měsíčně?</label>
        <div class="hero-calc-row">
          <div class="money"><input id="h-monthly" name="monthly" type="text" inputmode="numeric" autocomplete="off" value="3 000" /><span>Kč</span></div>
          <button class="btn btn-primary" type="submit">Spočítat</button>
        </div>
      </form>
      <p class="fine trust">
        Data z webů správců: <span class="issuers">Vanguard · iShares · State Street · Schwab</span><br />
        Staženo {formatDate(dataRetrieved)} · bez registrace
      </p>
    </div>

    <GlassCard class="hero-card" aria-label="Ukázka srovnání">
      <div class="variant-a">
        <p class="card-label">Americký originál → evropská verze</p>
        <ul class="pairs">
          {pairs.map((p) => (
            <li>
              <span class="pair-us"><strong>{p.us.ticker}</strong> <span class="num">{formatPct(p.us.expenseRatioPct)}</span></span>
              <span class="pair-arrow" aria-label="evropská verze">→</span>
              <span class="pair-eu"><strong>{p.euTicker}</strong> <span class="num">{formatPct(p.eu.terPct)}</span></span>
              <span class="pair-match fine">{p.eu.match} · <span class="nowrap">ISIN {p.eu.isin}</span></span>
            </li>
          ))}
        </ul>
        <p class="fine">Evropské verze (UCITS) mají ISIN začínající IE. Zda fond nabízí váš broker, ověříte podle ISIN. Poplatky: weby správců, viz <a href="/zdroje">zdroje</a>.</p>
      </div>
      <div class="variant-b">
      <div class="card-top">
        <p class="card-label">Stejný index S&amp;P 500</p>
        <span class="badge-mint">Poplatek VOO ~{feeRatio}× nižší</span>
      </div>
      <div class="duel">
        <div>
          <span class="ticker">{spy.ticker}</span>
          <span class="ter num">{formatPct(spy.expenseRatioPct)}</span>
          <span class="fine">roční poplatek</span>
        </div>
        <span class="vs" aria-hidden="true">vs.</span>
        <div>
          <span class="ticker">{voo.ticker}</span>
          <span class="ter ter-low num">{formatPct(voo.expenseRatioPct)}</span>
          <span class="fine">roční poplatek</span>
        </div>
      </div>
      <ul class="chips" aria-label="Srovnávané fondy">
        {usEtfs.map((e) => <li>{e.ticker}</li>)}
      </ul>
      <p class="fine">Zdroj: weby správců (ssga.com, vanguard.com), viz <a href="/zdroje">zdroje</a>.</p>
      </div>
    </GlassCard>
  </div>
</header>

<style>
  .hero { padding-top: var(--sp-5); padding-bottom: var(--sp-10); }
  .hero-grid { display: grid; gap: var(--sp-8); margin-top: var(--sp-2); align-items: center; }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: var(--sp-12); margin-top: var(--sp-10); }
    .hero { padding-bottom: var(--sp-16); }
  }
  .hero-copy { display: grid; gap: var(--sp-4); }
  .hero-copy h1 { max-width: 16ch; }
  @media (min-width: 900px) { .hero-copy h1 { max-width: 18ch; } }
  .lead { max-width: 34ch; }
  .cta-row { margin-top: var(--sp-2); }

  /* D28: control shows the button, hero_input the amount field (set on <html> before first paint) */
  .hero-calc { display: none; }
  :global(html[data-exp-hero='hero_input']) .hero-calc { display: grid; }
  :global(html[data-exp-hero='hero_input']) .cta-row { display: none; }
  .hero-calc { gap: var(--sp-2); margin-top: var(--sp-2); max-width: 30rem; min-width: 0; }
  .hero-calc label { font-size: var(--fs-sm); font-weight: var(--fw-medium); color: var(--c-navy-900); }
  .hero-calc-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-2); } /* minmax: the field never widens the page on phones */
  .hero-calc .money {
    display: flex; align-items: center; min-width: 0; min-height: 56px; padding-inline: var(--sp-4);
    background: var(--c-white); border: 1.5px solid var(--c-line); border-radius: var(--r-md);
  }
  .hero-calc .money:focus-within { border-color: var(--c-navy-700); outline: 3px solid var(--c-navy-700); outline-offset: 1px; }
  .hero-calc input {
    flex: 1; min-width: 0; border: 0; background: transparent; color: var(--c-ink);
    font: inherit; font-size: var(--fs-lg); font-weight: var(--fw-medium); font-variant-numeric: tabular-nums;
  }
  .hero-calc input:focus-visible { outline: none; }
  .hero-calc .money span { color: var(--c-ink-faint); }
  .hero-calc button { min-height: 56px; font-size: var(--fs-lg); padding-inline: var(--sp-6); }
  .hero-cta { width: 100%; font-size: var(--fs-lg); min-height: 56px; }
  @media (min-width: 600px) { .hero-cta { width: auto; } }
  .trust { max-width: 46ch; padding: var(--sp-2) var(--sp-3); border-radius: var(--r-sm); background: var(--c-navy-100); color: var(--c-navy-700); }

  /* Ad variant switch (D17): B is the default */
  .variant-a { display: none; }
  :global(html[data-ad='a']) .variant-a { display: block; }
  :global(html[data-ad='a']) .variant-b { display: none; }

  .card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--sp-2); }
  .issuers { font-weight: var(--fw-medium); white-space: nowrap; }
  .card-label { font-size: var(--fs-sm); font-weight: var(--fw-medium); color: var(--c-ink-muted); }
  .duel { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: var(--sp-3); margin-block: var(--sp-4); }
  .duel > div { display: grid; gap: var(--sp-1); }
  .ticker { font-weight: var(--fw-bold); font-size: var(--fs-lg); }
  .ter { white-space: nowrap; font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem); font-weight: var(--fw-bold); letter-spacing: var(--tracking-tight); line-height: 1; }
  .ter-low { color: var(--c-green-800); }
  .vs { color: var(--c-ink-faint); padding-bottom: var(--sp-6); }
  .chips { list-style: none; padding: 0; margin: 0 0 var(--sp-4); display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .pairs { list-style: none; padding: 0; margin: var(--sp-3) 0 var(--sp-4); display: grid; }
  .pairs li {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: baseline; gap: 2px var(--sp-3);
    padding-block: var(--sp-3); border-top: 1px solid var(--c-line);
  }
  .pairs li:first-child { border-top: 0; padding-top: 0; }
  .pairs strong { font-size: var(--fs-lg); color: var(--c-navy-900); }
  .pair-us { color: var(--c-ink-muted); white-space: nowrap; }
  .pair-arrow { color: var(--c-green-700); font-weight: var(--fw-bold); }
  .pair-eu { white-space: nowrap; }
  .pair-eu strong { color: var(--c-green-800); }
  .pair-match { grid-column: 1 / -1; color: var(--c-ink-faint); }
  .nowrap { white-space: nowrap; }
  .chips li {
    font-size: var(--fs-xs); font-weight: var(--fw-medium);
    padding: var(--sp-1) var(--sp-3); border-radius: var(--r-pill);
    background: var(--c-navy-100); color: var(--c-navy-700);
  }
</style>

<script>
  import { track } from '../lib/track';
  import { readCalc } from '../lib/calc-state';

  // D28 variant hero_input: hand the amount to the calculator (its own input handler recalculates,
  // remembers it and reports tool_used), then show the result
  const form = document.querySelector<HTMLFormElement>('[data-hero-calc]');
  const input = form?.querySelector<HTMLInputElement>('input');
  if (form && input) {
    const nf = new Intl.NumberFormat('cs-CZ');
    const digits = (s: string) => Number(s.replace(/\D/g, '').slice(0, 9)) || 0;
    const saved = readCalc();
    if (saved.touched) input.value = nf.format(saved.monthlyCzk);
    input.addEventListener('input', () => {
      const n = digits(input.value);
      input.value = n ? nf.format(n) : '';
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const monthly = digits(input.value);
      const target = document.querySelector<HTMLInputElement>('#c-monthly');
      if (target) {
        target.value = nf.format(monthly);
        target.dispatchEvent(new Event('input', { bubbles: true }));
      }
      track('hero_calc_submit', { monthly_czk: monthly });
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelector('.area-fees')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
  }
</script>
