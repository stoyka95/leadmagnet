---
// Fingramo logo (D26): an "F" whose top bar turns into a rising arrow. Navy = trust, emerald = money (D19).
// The same shapes live in public/logo.svg, public/logo-mark.svg and public/favicon.svg.
interface Props {
  tone?: 'light' | 'dark'; // dark = on navy backgrounds (footer): white stem and wordmark
  size?: number;           // mark height in px; the wordmark scales with it
  href?: string;           // wraps the logo in a link (e.g. back to the landing page)
  wordmark?: boolean;
}
const { tone = 'light', size = 34, href, wordmark = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<!-- a link is named by aria-label; a plain logo is an image (aria-label is not allowed on a bare span) -->
<Tag class:list={['logo', `logo-${tone}`]} href={href} role={href ? undefined : 'img'} aria-label={href ? 'Fingramo – úvodní stránka' : 'Fingramo'} style={`--logo-h:${size}px`}>
  <svg class="mark" viewBox="0 0 48 56" aria-hidden="true" focusable="false">
    <path class="stem" d="M6 26h10v8h12v8H16v12H6z" />
    <path class="arrow" d="M6 26V15L29.7 7.3 28.2 2.8 45.3 6.7 33.8 19.9 32.3 15.4 21 19Q16 20.6 16 24V26z" />
  </svg>
  {wordmark && <span class="word" aria-hidden="true">fingramo</span>}
</Tag>

<style>
  .logo {
    display: inline-flex; align-items: center; gap: calc(var(--logo-h) * 0.22);
    text-decoration: none; line-height: 1;
  }
  a.logo { min-height: 44px; } /* D35: touch target */
  .mark { height: var(--logo-h); width: calc(var(--logo-h) * 48 / 56); flex: none; }
  .stem { fill: var(--c-navy-900); }
  .arrow { fill: var(--c-green-500); }
  .word {
    font-family: var(--font-display); font-weight: var(--fw-bold);
    font-size: calc(var(--logo-h) * 0.72); letter-spacing: -0.03em;
    color: var(--c-navy-900);
    /* optical alignment: the wordmark sits on the stem's lower half like in the logo sheet */
    padding-top: calc(var(--logo-h) * 0.18);
  }
  .logo-dark .stem { fill: var(--c-white); }
  .logo-dark .word { color: var(--c-white); }
  a.logo:focus-visible { outline: 3px solid var(--c-navy-700); outline-offset: 4px; border-radius: var(--r-sm); }
</style>
