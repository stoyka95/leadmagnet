---
// CONTENT.md §3.6 – only facts verified in data/SOURCES.md §5. General information, not tax advice.
// D31: the two sale exemptions here; US dividends are a question in the FAQ.
const facts = [
  {
    title: 'Po 3 letech bez daně z prodeje',
    text: 'Příjem z prodeje cenného papíru drženého déle než 3 roky je osvobozen od daně.',
    source: { label: '§ 4 odst. 1 písm. u) zákona o daních z příjmů', href: 'https://www.zakonyprolidi.cz/cs/1992-586' },
  },
  {
    title: 'Do 100 000 Kč ročně',
    text: 'Příjmy z prodeje cenných papírů jsou osvobozeny, pokud za rok v úhrnu nepřesáhnou 100 000 Kč.',
    source: { label: '§ 4 odst. 1 písm. t) zákona o daních z příjmů', href: 'https://www.zakonyprolidi.cz/cs/1992-586' },
  },
];
import Icon from './Icon.astro';
---
<section id="dane" class="block" aria-labelledby="tax-h">
  <h3 id="tax-h" class="block-h"><Icon name="receipt" size={28} />Kdy se z prodeje daň neplatí</h3>
  <div class="facts">
    {facts.map((f) => (
      <article>
        <h4>{f.title}</h4>
        <p class="muted">{f.text}</p>
        <p class="fine">Zdroj: <a href={f.source.href} rel={f.source.href.startsWith('http') ? 'noopener' : undefined}>{f.source.label}</a></p>
      </article>
    ))}
  </div>
  <p class="fine note">Obecná informace pro daňového rezidenta ČR, ne daňové poradenství. Dividendy z USA najdete v častých otázkách.</p>
</section>

<style>
  .facts { display: grid; gap: var(--sp-4); }
  .block-h { font-size: var(--fs-xl); margin-bottom: var(--sp-5); display: flex; align-items: center; gap: var(--sp-3); color: var(--c-navy-900); }
  .block-h :global(.icon) { color: var(--c-navy-700); } /* D36 */
  h4 { margin: 0; font-size: var(--fs-md); color: var(--c-navy-900); }
  .note { margin-top: var(--sp-3); }
  /* D31: compact like the list next to it – a line instead of a card */
  article { padding-left: var(--sp-4); border-left: 3px solid var(--c-green-500); display: grid; gap: var(--sp-1); align-content: start; }
  .facts { gap: var(--sp-5); }
</style>
