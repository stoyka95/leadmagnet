---
// Mobile sticky CTA: appears after the hero, hides while the calculator or a form is on screen.
---
<div class="sticky" data-sticky aria-hidden="true">
  <a class="btn btn-primary btn-block" href="#kalkulacka" tabindex="-1" data-track="cta_click" data-cta="sticky">Spočítat moje poplatky</a>
</div>

<style>
  .sticky {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
    padding: var(--sp-3) var(--gutter) calc(var(--sp-3) + env(safe-area-inset-bottom));
    background: var(--glass-fallback);
    border-top: 1px solid var(--c-line);
    transform: translateY(110%);
    transition: transform var(--dur) var(--ease);
  }
  .sticky.on { transform: none; }
  @media (min-width: 900px) { .sticky { display: none; } }
  @media (prefers-reduced-motion: reduce) { .sticky { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky]')!;
  const link = bar.querySelector<HTMLAnchorElement>('a')!;
  const hero = document.querySelector('.hero');
  const blockers = document.querySelectorAll('#kalkulacka, [data-lead-form]');
  let heroGone = false;
  const visibleBlockers = new Set<Element>();

  const update = () => {
    const on = heroGone && visibleBlockers.size === 0;
    bar.classList.toggle('on', on);
    bar.setAttribute('aria-hidden', String(!on));
    link.tabIndex = on ? 0 : -1;
  };

  if (hero) {
    new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting; update(); }).observe(hero);
  }
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? visibleBlockers.add(e.target) : visibleBlockers.delete(e.target);
    update();
  });
  blockers.forEach((b) => io.observe(b));
</script>
