---
// Second tool (D4): pick what you want → US original vs. European (UCITS) version. Leads to the same form.
import GlassCard from './GlassCard.astro';
import LeadForm from './LeadForm.astro';
import { groups, etfByTicker, ucitsFor, ucitsEtfs, formatPct, formatUsdBig, formatDate, dataRetrieved, euLabel } from '../lib/etf';
const minEuTer = Math.min(...ucitsEtfs.map((u) => u.terPct));
---
<section id="srovnani" class="section container" aria-labelledby="cmp-h">
  <div class="section-head">
    <p class="eyebrow">Srovnání 6 ETF</p>
    <h2 id="cmp-h">Americký originál, nebo evropská verze?</h2>
    <p class="lead">Vyberte, co chcete mít v portfoliu. Ukážeme fond z newyorské burzy a evropský fond se stejným, nebo podobným indexem, který drobní investoři v EU běžně koupí.</p>
  </div>

  <div class="switch" role="group" aria-label="Co chcete">
    {groups.map((g, i) => (
      <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-group={g.id}>{g.label}</button>
    ))}
  </div>

  {groups.map((g, i) => (
    <div class="group" data-panel={g.id} hidden={i !== 0}>
      {g.tickers.map((t) => {
        const us = etfByTicker(t);
        const eu = ucitsFor(us);
        const sameIndex = eu.match === 'stejný index';
        return (
          <div class="pair">
            <GlassCard as="article" class="fund">
              <p class="tag">Originál · {us.exchange}</p>
              <h3><span class="tk">{us.ticker}</span> {us.name}</h3>
              <dl>
                <div><dt>Roční poplatek</dt><dd class="num strong">{formatPct(us.expenseRatioPct)}</dd></div>
                <div><dt>Velikost</dt><dd class="num">{formatUsdBig(us.aumUsd)}</dd></div>
                <div><dt>Index</dt><dd>{us.index}</dd></div>
              </dl>
              <p class="note">Bez dokumentu KID, u řady brokerů v EU nedostupné.</p>
            </GlassCard>
            <GlassCard as="article" class="fund fund-eu">
              <p class="tag">{euLabel(eu.match)} · UCITS</p>
              <h3><span class="tk">{eu.ticker.split(' ')[0]}</span> {eu.name}</h3>
              <dl>
                <div><dt>Roční poplatek</dt><dd class="num strong">{formatPct(eu.terPct)}</dd></div>
                <div><dt>ISIN</dt><dd class="num">{eu.isin}</dd></div>
                <div><dt>Index</dt><dd>{eu.index}</dd></div>
              </dl>
              <p class="badges">
                <span class:list={['badge', sameIndex ? 'badge-ok' : 'badge-warn']}>{sameIndex ? 'Stejný index' : 'Podobný, jiný index'}</span>
                {eu.terPct === minEuTer && <span class="badge-mint">Nejnižší poplatek</span>}
                {eu.registeredCZ && <span class="badge badge-ok">Registrováno pro ČR</span>}
              </p>
            </GlassCard>
          </div>
        );
      })}
    </div>
  ))}

  <p class="fine src">
    Zdroj: weby správců (State Street, iShares, Vanguard, Schwab, DWS), staženo {formatDate(dataRetrieved)}. Velikost = ETF třída fondu. Registrace pro ČR podle State Street. <a href="/zdroje">Všechny zdroje</a>
  </p>

  <!-- D35: the base page has 2 lead forms – this button leads to the one under the calculator.
       The third form here is only in the variant ?forms=3 (hypothesis in README). -->
  <div class="cta forms2-only">
    <a class="btn btn-ghost" href="#lf-calculator-h" data-gate-open data-track="cta_click" data-cta="compare_send">Poslat srovnání e-mailem</a>
  </div>
  <div class="forms3-only">
    <div class="cta">
      <button type="button" class="btn btn-ghost" data-open-compare-form aria-expanded="false" aria-controls="compare-form">Poslat srovnání e-mailem</button>
    </div>
    <div id="compare-form" class="form-wrap" hidden>
      <LeadForm location="compare" wide heading="Pošleme vám všech 6 párů v jednom e-mailu" />
    </div>
  </div>
</section>

<style>
  .switch { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-bottom: var(--sp-6); }
  .chip {
    min-height: 44px; padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-pill); border: 1.5px solid var(--c-line);
    background: var(--solid-bg); color: var(--c-ink);
    font: inherit; font-size: var(--fs-sm); font-weight: var(--fw-medium); cursor: pointer;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .chip[aria-pressed='true'] { background: var(--c-navy-700); border-color: var(--c-navy-700); color: var(--c-white); }
  .group { display: grid; gap: var(--sp-6); }
  .pair { display: grid; gap: var(--sp-3); }
  @media (min-width: 768px) { .pair { grid-template-columns: 1fr 1fr; gap: var(--sp-4); } }
  .fund h3 { font-size: var(--fs-md); margin-top: var(--sp-1); }
  .tk { display: block; font-size: var(--fs-xl); font-weight: var(--fw-bold); }
  .tag { font-size: var(--fs-xs); color: var(--c-ink-faint); font-weight: var(--fw-medium); letter-spacing: 0.04em; text-transform: uppercase; }
  .fund-eu .tag { color: var(--c-green-800); }
  dl { margin: var(--sp-4) 0 0; display: grid; gap: var(--sp-2); }
  dl > div { display: flex; justify-content: space-between; gap: var(--sp-4); border-top: 1px solid var(--c-line); padding-top: var(--sp-2); }
  dt { color: var(--c-ink-muted); font-size: var(--fs-sm); }
  dd { margin: 0; text-align: right; font-size: var(--fs-sm); }
  .strong { font-weight: var(--fw-bold); font-size: var(--fs-md); }
  .note { margin-top: var(--sp-3); font-size: var(--fs-xs); color: var(--c-ink-muted); }
  .badges { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
  .badge { font-size: var(--fs-xs); font-weight: var(--fw-medium); padding: 2px var(--sp-3); border-radius: var(--r-pill); }
  .badge-ok { background: var(--c-green-100); color: var(--c-green-900); }
  .badge-warn { background: var(--c-bg-2); color: var(--c-ink-muted); }
  .src { margin-top: var(--sp-6); max-width: var(--w-text); }
  .cta { margin-top: var(--sp-6); }
  .cta .btn { width: 100%; }
  @media (min-width: 600px) { .cta .btn { width: auto; } }
  :global(:root:not([data-forms='3'])) .forms3-only, :global(:root[data-forms='3']) .forms2-only { display: none; }
  /* D35: on phones the original and its European version sit side by side – the comparison is read across,
     and the section is ~40 % shorter. Labels go above the values, so nothing is squeezed. */
  @media (max-width: 767px) {
    .pair { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--sp-2); }
    .pair :global(.card) { padding: var(--sp-3); }
    .group { gap: var(--sp-4); }
    .tag { font-size: 0.6875rem; letter-spacing: 0.02em; }
    .fund h3 { font-size: var(--fs-xs); font-weight: var(--fw-medium); line-height: var(--lh-snug); }
    .tk { font-size: var(--fs-lg); }
    dl { margin-top: var(--sp-3); }
    dl > div { display: grid; gap: 0; justify-content: stretch; }
    dd { text-align: left; overflow-wrap: anywhere; }
    dt, dd { font-size: var(--fs-xs); }
    .strong { font-size: var(--fs-md); }
    .note { font-size: 0.6875rem; }
    .badges { gap: var(--sp-1); }
  }
  .form-wrap { margin-top: var(--sp-4); scroll-margin-top: var(--sp-6); }
</style>

<script>
  import { track } from '../lib/track';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-group]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const id = btn.dataset.group!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      track('tool_used', { tool: 'compare', group: id });
    });
  }

  const opener = document.querySelector<HTMLButtonElement>('[data-open-compare-form]')!;
  const wrap = document.getElementById('compare-form')!;
  opener.addEventListener('click', () => {
    wrap.hidden = false;
    opener.setAttribute('aria-expanded', 'true');
    opener.hidden = true;
    track('cta_click', { cta: 'compare_send' });
    // Show the whole form including its heading, then put the cursor in the first field
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    wrap.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    wrap.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  });
</script>
