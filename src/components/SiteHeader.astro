---
// Sticky top bar (D27, D30): the logo stays visible; the button first leads to the calculator (value before
// the form) and, once the visitor has calculated something, to the form at the end of the page.
// It replaces the mobile sticky bottom CTA, so there is one sticky call to action on every screen size.
import Logo from './Logo.astro';
---
<header class="site-header" data-site-header data-mode="calc">
  <div class="container bar">
    <Logo size={32} href="/" />
    <a class="btn btn-primary cta" href="#kalkulacka" data-header-cta data-track="cta_click" data-cta="header_calc">
      <span class="when-calc">Spočítat poplatky</span>
      <span class="when-form">Získat srovnání<span class="long">&nbsp;zdarma</span></span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  /* Glass only once the page moves, so the hero keeps its open look */
  .site-header.scrolled {
    background: var(--glass-fallback);
    border-bottom-color: var(--c-line);
  }
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header.scrolled {
      background: var(--glass-bg);
      -webkit-backdrop-filter: blur(var(--glass-blur)); backdrop-filter: blur(var(--glass-blur));
    }
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); min-height: var(--header-h); }
  .cta { gap: 0; min-height: 44px; padding: var(--sp-2) var(--sp-5); font-size: var(--fs-sm); white-space: nowrap; }
  .long { display: none; }
  @media (min-width: 600px) { .long { display: inline; } .cta { font-size: var(--fs-md); } }
  .when-form { display: none; }
  .site-header[data-mode='form'] .when-calc { display: none; }
  .site-header[data-mode='form'] .when-form { display: inline; }
  @media (prefers-reduced-motion: reduce) { .site-header { transition: none; } }
</style>

<script>
  import { readCalc } from '../lib/calc-state';

  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  const cta = header.querySelector<HTMLAnchorElement>('[data-header-cta]')!;
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // D30: "calc" until the visitor has used the calculator (in this tab), then "form"
  const toForm = () => {
    if (header.dataset.mode === 'form') return;
    header.dataset.mode = 'form';
    cta.href = '#lf-footer-h';
    cta.dataset.cta = 'header';
  };
  if (readCalc().touched) toForm();
  document.querySelector('[data-calc]')?.addEventListener('input', toForm);
  document.querySelector('[data-hero-calc]')?.addEventListener('submit', toForm);

  // "calc" mode is a plain link to #kalkulacka (no focus: on phones the keyboard would cover the result).
  // "form" mode goes straight into the e-mail field of the last form.
  cta.addEventListener('click', (e) => {
    if (header.dataset.mode !== 'form') return;
    const target = document.querySelector<HTMLInputElement>('#lf-footer-email');
    if (!target) return;
    e.preventDefault();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    target.focus({ preventScroll: true });
  });
</script>
