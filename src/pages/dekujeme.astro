---
// After submit (CONTENT.md §4): the full comparison immediately, Save as PDF, next steps.
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import GlassCard from '../components/GlassCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { brokerQuestions } from '../lib/report';
import { formatDate, dataRetrieved } from '../lib/etf';
---
<BaseLayout title="Hotovo – vaše srovnání ETF | Fingramo" description="Vaše srovnání ETF s poplatky v korunách." noindex>
  <main class="container wrap">
    <div class="brand"><Logo href="/" size={32} /></div>

    <header class="head">
      <p class="eyebrow">Hotovo</p>
      <h1 data-hello>Srovnání je na cestě do vašeho e-mailu.</h1>
      <p class="lead">Tady ho máte hned. <span data-amount></span></p>
      <div class="actions no-print">
        <button type="button" class="btn btn-primary" data-print>Uložit jako PDF</button>
        <a class="btn btn-ghost" href="/#kalkulacka">Upravit výpočet</a>
      </div>
    </header>

    <GlassCard solid class="report">
      <table>
        <caption class="visually-hidden">Poplatky fondů v korunách za 10 a 20 let</caption>
        <thead>
          <tr><th scope="col">Fond</th><th scope="col" class="r">Poplatek</th><th scope="col" class="r">10 let</th><th scope="col" class="r">20 let</th></tr>
        </thead>
        <tbody data-report></tbody>
      </table>
      <p class="fine">Počítáno z ročního poplatku fondu (TER) bez růstu investice. Nezahrnuje poplatky brokera, převod měny ani daně. Data ze stránek správců, staženo {formatDate(dataRetrieved)} – <a href="/zdroje">zdroje</a>. Nejde o investiční doporučení.</p>
    </GlassCard>

    <GlassCard solid class="growth">
      <h2 id="growth-h">Jak by mohla investice vypadat za <span data-kid-years></span> let</h2>
      <p class="muted">Čtyři scénáře z dokumentu KID fondu <span data-kid-ticker></span> (S&amp;P 500, evropská verze) pro vaši částku.</p>
      <ul class="bars" data-bars aria-labelledby="growth-h"></ul>
      <p class="fine" data-kid-note></p>

      <h3 class="hist-h">Historie S&amp;P 500 za <span data-hist-years></span> let</h3>
      <div class="hist" data-hist></div>
      <p class="fine" data-hist-note></p>
    </GlassCard>

    <section class="next" aria-labelledby="next-h">
      <h2 id="next-h">Co dál?</h2>
      <ol>
        <li><strong>Vyberte brokera</strong> a zeptejte se ho:
          <ul>{brokerQuestions.map((q) => <li>{q}</li>)}</ul>
        </li>
        <li><strong>Ověřte, že nabízí zvolený fond</strong> – hledejte podle ISIN evropské verze.</li>
        <li><strong>Přečtěte si KID</strong> fondu, než nakoupíte.</li>
      </ol>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .wrap { padding-block: var(--sp-6) var(--sp-16); display: grid; gap: var(--sp-8); }
  .head { display: grid; gap: var(--sp-3); max-width: var(--w-text); }
  h1 { font-size: var(--fs-2xl); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-top: var(--sp-2); }
  table { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); font-variant-numeric: tabular-nums; margin-bottom: var(--sp-4); }
  th { text-align: left; font-size: var(--fs-xs); color: var(--c-ink-faint); font-weight: var(--fw-medium); padding-bottom: var(--sp-2); }
  .r { text-align: right; }
  :global(.report td) { padding: var(--sp-2) 0; border-top: 1px solid var(--c-line); vertical-align: top; }
  :global(.report td.r) { text-align: right; padding-left: var(--sp-2); white-space: nowrap; }
  :global(.report tr.us td) { border-top: 2px solid var(--c-line); font-weight: var(--fw-medium); }
  :global(.report .sub) { display: block; font-size: var(--fs-xs); color: var(--c-ink-faint); font-weight: var(--fw-regular); }
  :global(.growth) h2 { font-size: var(--fs-xl); margin-bottom: var(--sp-2); }
  .bars { list-style: none; margin: var(--sp-4) 0; padding: 0; display: grid; gap: var(--sp-3); }
  :global(.bars li) { display: grid; grid-template-columns: 1fr auto; gap: var(--sp-1) var(--sp-3); font-size: var(--fs-sm); }
  :global(.bars .v) { font-weight: var(--fw-bold); color: var(--c-navy-900); white-space: nowrap; }
  :global(.bars .sub) { color: var(--c-ink-faint); white-space: nowrap; }
  :global(.bars .track) { grid-column: 1 / -1; height: 10px; border-radius: var(--r-pill); background: var(--c-bg-2); overflow: hidden; }
  :global(.bars .fill) { display: block; height: 100%; border-radius: inherit; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .hist-h { font-size: var(--fs-lg); margin: var(--sp-6) 0 var(--sp-3); }
  .hist { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); padding: var(--sp-4); border-radius: var(--r-md); background: var(--c-navy-100); margin-bottom: var(--sp-3); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  :global(.hist div) { display: grid; gap: 2px; font-size: var(--fs-xs); color: var(--c-ink-muted); }
  :global(.hist strong) { font-size: var(--fs-lg); color: var(--c-navy-900); white-space: nowrap; }
  .next ol { padding-left: var(--sp-5); display: grid; gap: var(--sp-3); max-width: var(--w-text); }
  .next h2 { font-size: var(--fs-xl); margin-bottom: var(--sp-3); }
  @media print {
    :global(.page-bg), .no-print, :global(.footer) { display: none !important; }
    :global(body) { background: #fff; }
  }
</style>

<script>
  import { buildReport, buildGrowth, SCENARIO_COLOURS, PAID_COLOUR } from '../lib/report';
  import { formatDate } from '../lib/etf';
  import { formatCzk } from '../lib/fees';
  import { formatPct } from '../lib/etf';
  import { readCalc } from '../lib/calc-state';
  import { track } from '../lib/track';

  const calc = readCalc();
  let lead: { firstName?: string; email?: string } = {};
  try { lead = JSON.parse(sessionStorage.getItem('fg:lead') ?? '{}'); } catch { /* ignore */ }

  if (lead.firstName) document.querySelector('[data-hello]')!.textContent = `Děkujeme, ${lead.firstName}. Srovnání je na cestě do e-mailu.`;
  document.querySelector('[data-amount]')!.textContent =
    `Pro ${formatCzk(calc.onceCzk)} jednorázově + ${formatCzk(calc.monthlyCzk)} měsíčně.`;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  document.querySelector('[data-report]')!.innerHTML = buildReport(calc)
    .map((r) => `
      <tr class="us"><td>${esc(r.ticker)}<span class="sub">${esc(r.index)}</span></td><td class="r">${formatPct(r.ter)}</td><td class="r">${formatCzk(r.fees10)}</td><td class="r">${formatCzk(r.fees20)}</td></tr>
      <tr><td>→ ${esc(r.euTicker)}<span class="sub">${esc(r.euIsin)} · ${esc(r.euMatch)}</span></td><td class="r">${formatPct(r.euTer)}</td><td class="r">${formatCzk(r.euFees10)}</td><td class="r">${formatCzk(r.euFees20)}</td></tr>`)
    .join('');

  // D27: the part the gate unlocked (scenarios + history), same numbers as the e-mail and the PDF
  const g = buildGrowth(calc);
  const signed = (v: number) => `${v > 0 ? '+' : ''}${formatPct(v)}`;
  const max = Math.max(g.paidIn, ...g.scenarios.map((x) => x.end), 1);
  const bar = (name: string, sub: string, value: number, colour: string) => `
    <li><span>${name} <span class="sub">${sub}</span></span><span class="v">${formatCzk(value)}</span>
    <span class="track" aria-hidden="true"><span class="fill" style="width:${Math.max(2, (value / max) * 100)}%;background:${colour}"></span></span></li>`;
  document.querySelector('[data-kid-years]')!.textContent = String(g.kidYears);
  document.querySelector('[data-kid-ticker]')!.textContent = g.kid.ticker;
  document.querySelector('[data-bars]')!.innerHTML = [
    bar('Vloženo', 'vaše vklady', g.paidIn, PAID_COLOUR),
    ...g.scenarios.map((x) => bar(`${esc(x.label)} scénář`, `(${signed(x.avgAnnualPct)} ročně)`, x.end, SCENARIO_COLOURS[x.id] ?? '')),
  ].join('');
  document.querySelector('[data-kid-note]')!.innerHTML =
    `<strong>Nejde o předpověď.</strong> Ilustrace podle průměrných ročních výnosů po nákladech z KID ze dne ${formatDate(g.kid.date)}. Hodnota investice může klesnout a můžete přijít o část vložených peněz. KID počítá s jednorázovou investicí, my průměrné výnosy používáme i na měsíční vklady. <a href="${esc(g.kid.source)}" rel="noopener">KID (PDF)</a>`;
  const h = g.history;
  document.querySelector('[data-hist-years]')!.textContent = String(h.years);
  document.querySelector('[data-hist]')!.innerHTML = [
    ['Nejhorší', h.worstPct, h.worstPeriod], ['Medián', h.medianPct, 'všech období'], ['Nejlepší', h.bestPct, h.bestPeriod],
  ].map(([t, v, p]) => `<div><span>${t}</span><strong>${signed(v as number)}</strong><span>${esc(String(p))}</span></div>`).join('');
  document.querySelector('[data-hist-note]')!.innerHTML =
    `Průměrný roční výnos za všechna stejně dlouhá období v letech ${esc(g.historySource.years)}. <strong>Historie, ne předpověď.</strong> V amerických dolarech, včetně dividend, bez daní a poplatků. Zdroj: <a href="${esc(g.historySource.url)}" rel="noopener">A. Damodaran, NYU Stern</a>.`;

  document.querySelector('[data-print]')!.addEventListener('click', () => {
    track('cta_click', { cta: 'save_pdf' });
    window.print();
  });

  track('thank_you_view', { used_calculator: calc.touched });
</script>
