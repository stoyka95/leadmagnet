---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import EtfCompare from '../components/EtfCompare.astro';
import KidExplainer from '../components/KidExplainer.astro';
import WhatYouGet from '../components/WhatYouGet.astro';
import TaxFacts from '../components/TaxFacts.astro';
import Faq from '../components/Faq.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<BaseLayout
  title="Srovnání ETF z NYSE a poplatky v Kč | Fingramo"
  description="SPY, IVV, VOO, VTI, VT a SCHD vedle jejich evropských verzí. Spočítejte si poplatky v korunách pro vaši částku – zdarma, data přímo od správců."
>
  <script is:inline slot="head">
    // D17: pick the hero variant before first paint from utm_content (a | b); default b.
    try {
      var v = new URLSearchParams(location.search).get('utm_content');
      if (v === 'a') document.documentElement.dataset.ad = 'a';
    } catch (e) {}
    // D28: live A/B test of the first screen (hypothesis H2). 50/50 at random, before first paint (no flicker),
    // remembered only in this tab (sessionStorage) – nothing persistent, cookieless measurement (D24) stays.
    // ?exp=control | hero_input forces a variant for checks and tests.
    (function () {
      var KEY = 'fg:exp_hero_calc', ok = { control: 1, hero_input: 1 }, exp;
      try {
        exp = new URLSearchParams(location.search).get('exp');
        if (!ok[exp]) exp = sessionStorage.getItem(KEY);
        if (!ok[exp]) exp = Math.random() < 0.5 ? 'control' : 'hero_input';
        sessionStorage.setItem(KEY, exp);
      } catch (e) {
        exp = Math.random() < 0.5 ? 'control' : 'hero_input';
      }
      document.documentElement.dataset.expHero = exp;
    })();
  </script>
  <SiteHeader />
  <Hero />
  <main id="obsah">
    <Calculator />
    <EtfCompare />
    <KidExplainer />
    <WhatYouGet />
    <TaxFacts />
    <Faq />
  </main>
  <SiteFooter />
</BaseLayout>
