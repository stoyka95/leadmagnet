# Copy to .env and fill in. Never commit .env.

# Supabase (server-side only – used by the form endpoint)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional e-mail with the comparison)
RESEND_API_KEY=
EMAIL_FROM=

# PostHog (EU cloud) – public project key, safe in the browser
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
